rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // NOTE: This app uses Clerk for authentication, NOT Firebase Auth.
    // Because request.auth is always null, we cannot use it to gate access.
    // For production, consider using Clerk's Firebase custom token integration
    // or a backend (Cloud Functions) to mediate writes.

    // USERS
    match /users/{userId} {
      allow read, write: if true;

    }

    // ROOMS
    match /rooms/{roomId} {
      allow read, write: if true;

      // MESSAGES SUBCOLLECTION
      match /messages/{messageId} {
        allow read, write: if true;
      }

      // TRUST SUBCOLLECTION
      match /trust/{userId} {
        allow read, write: if true;
      }
    }

    // CHATS (DMs)
    match /chats/{chatId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // REPORTS — anyone can create, no one can read/update/delete from client
    match /reports/{reportId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // EXPLORE ROOMS
    match /exploreRooms/{roomId} {
      allow read: if true;
      allow write: if false; // Only backend/functions should write this
    }

    // GLOBAL ROOMS
    match /globalRooms/{roomId} {
      allow read: if true;
      allow write: if false; // Only backend/functions should write this
    }

    // Fallback — deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
